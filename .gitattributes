# One line-ending rule for everyone. Without this file the behavior depended on each
# developer's local core.autocrlf, and git warned "LF will be replaced by CRLF" on every
# operation. Now the rule lives in the repository: LF in the index and in the working copy.
* text=auto eol=lf

# Windows scripts must keep CRLF, otherwise cmd will not run them.
*.bat text eol=crlf
*.cmd text eol=crlf

# Git must not touch binaries with line-ending normalization. Critical for the Roborazzi
# screenshot baselines: any change of bytes breaks their comparison.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ttf binary
*.otf binary
*.jar binary
*.keystore binary
*.zip binary
