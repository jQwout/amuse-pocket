<?xml version="1.0" encoding="utf-8"?><!--
   Auto backup rules for Android 11 and older (API < 31). On 31+ data_extraction_rules.xml is in effect —
   keeping both files in agreement is mandatory: the project's minSdk is 24, so this path is alive, not legacy.

   The template comment from Android Studio claimed the opposite ("ignored for devices older than API 31") —
   that is about the OTHER file. Here it is the other way round: this one works exactly below 31.

   Why things are excluded is explained in detail in data_extraction_rules.xml. In short:
   - secure_settings.xml: EncryptedSharedPreferences, the key lives in the Keystore and is not backed up, so
     a restored file cannot be decrypted and the app fails on the first read of the API key;
   - ai_open_pocket_db: all the conversations and the agent's memory in plain text — not for Google's cloud.
     (Here, unlike API 31+, there is no separate device-transfer channel, so the exclusion is shared.)
   - agent/, agents/, lesson_images/: the agent's files and the "for me" images — the same privacy as the
     database.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_settings.xml"/>
    <exclude domain="database" path="ai_open_pocket_db"/>
    <exclude domain="database" path="ai_open_pocket_db-wal"/>
    <exclude domain="database" path="ai_open_pocket_db-shm"/>
    <exclude domain="file" path="agent"/>
    <exclude domain="file" path="agents"/>
    <exclude domain="file" path="lesson_images"/>
</full-backup-content>
