<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- A voice call keeps hearing off screen (CallForegroundService): Android 14+ asks for the type's own permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- On-time reminders (HeartbeatAlarm): an exact while-idle alarm fires in Doze, where a delayed
         WorkManager job waits for a maintenance window. USE_EXACT_ALARM is granted on install (API 33+);
         SCHEDULE_EXACT_ALARM covers API 31-32. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- So that SpeechRecognizer finds the system recognition service on Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <!-- So that TextToSpeech finds the phone's speech engine on Android 11+ (replies read aloud). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name="com.aiopenpocket.AiOpenPocketApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout">
            <!-- A call shrinks into a picture-in-picture window when the person leaves it; the size changes
                 above are handled by Compose, so the window resizes without recreating the call. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets the app be chosen as the "digital assistant" and
                 opens the screen when the assistant is invoked (ACTION_ASSIST). -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The assistant button opens this over the current app (AssistSession starts it). -->
        <activity
            android:name="com.aiopenpocket.ui.assistant.AssistantActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.MyApplication.Assistant"
            android:windowSoftInputMode="adjustResize" />

        <!-- The camera writes the lesson clip into our cacheDir (not the gallery) — it needs a content URI for the file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/lesson_file_paths" />
        </provider>

        <!-- Registers the app as the system voice assistant. -->
        <service
            android:name="com.aiopenpocket.voice.AssistInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name="com.aiopenpocket.voice.AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService" />
            </intent-filter>
        </service>

        <service
            android:name="com.aiopenpocket.voice.AssistRecognitionService"
            android:exported="true"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Lives only while an agent turn is running; started from AndroidTurnLifeSupport. -->
        <service
            android:name="com.aiopenpocket.agent.core.notification.TurnForegroundService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- A voice call going on off screen: its notification, and the mute / hang-up buttons. -->
        <service
            android:name="com.aiopenpocket.voice.call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <receiver
            android:name="com.aiopenpocket.voice.call.CallControlReceiver"
            android:exported="false" />

        <!-- Fires a one-time heartbeat on time; see HeartbeatAlarm. -->
        <receiver
            android:name="com.aiopenpocket.agent.workers.HeartbeatAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
