flowchart TB
    U(["You · text, voice or a lesson"])
    subgraph PHONE["Your phone · AI Open Pocket"]
        direction TB
        RT["Agent router<br/>which agent takes this"]
        LOOP["Agent loop<br/>prompt → model → tools → repeat<br/>deleting or sending waits for your yes"]
        TOOLS["16 on-device tools<br/>memory · reminders · calendar · files · cards"]
        SCR["The agent's own screen<br/>a signed Ketoy bundle"]
        RT --> LOOP
        LOOP --> TOOLS
    end
    subgraph META["Meta Model API · your key"]
        direction LR
        SPARK["Muse Spark · Muse Wonder<br/>tools · streaming · reasoning"]
        HOSTED["web_search · SAM 3.1<br/>Muse Image"]
    end
    subgraph FORGE["The forge · a server you run"]
        direction TB
        GW["Gateway<br/>jobs + bundles"]
        WK["Worker<br/>coding agent + Gradle<br/>+ Ketoy compiler"]
        GW <--> WK
    end
    U --> RT
    LOOP <-->|"SSE stream"| SPARK
    LOOP --> HOSTED
    LOOP -.->|"publish with<br/>own interface"| GW
    GW -->|".ktx bundle"| SCR
    WK <-->|"tool calls"| SPARK
    classDef you fill:#D4F06A,stroke:#D4F06A,color:#10160C
    classDef meta fill:#22301C,stroke:#D4F06A,stroke-width:2px,color:#F4FAE8
    classDef cloud fill:#15232A,stroke:#7CC7DB,stroke-width:2px,color:#E3F4F8
    class U you
    class SPARK,HOSTED meta
    class GW,WK,SCR cloud
